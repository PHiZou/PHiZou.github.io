---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Peter Hagen – GovCon Data Engineering & Analytics",
  description = "NOVA/DMV-based data and analytics professional building SQL/Python pipelines, reporting layers, and explainable decision-support tools across GovCon, membership analytics, procurement intelligence, and AI workflows.",
} = Astro.props as Props;

const NAV_ITEMS = [
  { id: "home", label: "Home", href: "/" },
  { id: "consulting", label: "Consulting", href: "/consulting" },
  { id: "products", label: "Data Products", href: "/products", badge: "New" },
  { id: "defense", label: "Defense & Intel", href: "/defense" },
  { id: "projects", label: "All Projects", href: "/projects" },
  { id: "resume", label: "Resume", href: "/resume" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(href + "/");
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mark JS available before paint so scroll-reveal has no flash of hidden content -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`https://phizou.github.io${Astro.url.pathname}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / LinkedIn / Slack previews -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://phizou.github.io${Astro.url.pathname}`} />
    <meta property="og:site_name" content="Peter Hagen – Portfolio" />
    <meta property="og:image" content="https://phizou.github.io/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://phizou.github.io/og-image.png" />

    <!-- Additional SEO -->
    <meta name="author" content="Peter Hagen" />
    <meta name="robots" content="index, follow" />
  </head>
  <body class="min-h-full antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
      style="background: var(--teal); color: var(--bg);"
    >
      Skip to main content
    </a>
    <div style="min-height: 100dvh; display: flex; flex-direction: column;">
      <header class="site-header">
        <div class="site-header-inner">
          <a href="/" class="brand">
            <span class="brand-name">Peter Hagen</span>
            <span class="brand-sub">NOVA · DMV · GovCon Analytics</span>
          </a>
          <nav aria-label="Main navigation" class="site-nav">
            {NAV_ITEMS.map((item) => (
              <a href={item.href} class:list={["nav-link", { "nav-active": isActive(item.href) }]}>
                {item.label}
                {item.badge && <span class="nav-badge">{item.badge}</span>}
              </a>
            ))}
            <a
              href="https://www.linkedin.com/in/peterhagen123"
              target="_blank"
              rel="noopener noreferrer"
              class="nav-linkedin"
            >
              LinkedIn ↗
            </a>
          </nav>
        </div>
      </header>

      <main id="main-content" style="flex: 1;">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-inner">
          <div>
            <div class="footer-name">Peter Hagen</div>
            <div class="footer-tagline">
              Fractional Data & Analytics Engineer · NOVA/DMV GovCon · Open to FTE roles
            </div>
          </div>
          <div class="footer-links">
            <a href="mailto:Peter.H.Hagen@gmail.com">Email</a>
            <a href="https://www.linkedin.com/in/peterhagen123" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
            <a href="https://github.com/PHiZou" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const items = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduce || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("in-view"));
      } else {
        // Stagger siblings that share a parent so lists cascade instead of popping together.
        items.forEach((el) => {
          const sibs = Array.from(
            el.parentElement?.querySelectorAll(":scope > .reveal") ?? []
          );
          const i = sibs.indexOf(el);
          if (i > 0) el.style.setProperty("--reveal-delay", `${Math.min(i, 8) * 60}ms`);
        });

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.1 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border-header);
    background: var(--bg-header);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 3px rgba(101, 123, 131, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-decoration: none;
  }
  .brand-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .brand-sub {
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--ink-4);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .site-nav {
    display: flex;
    gap: 4px;
    align-items: center;
  }
  .nav-link {
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.15s;
    position: relative;
  }
  .nav-link:hover { color: var(--ink); }
  .nav-active { color: var(--teal) !important; }
  .nav-badge {
    margin-left: 4px;
    font-size: 0.55rem;
    font-weight: 700;
    background: oklch(0.948 0.055 280);
    color: oklch(0.559 0.12 280);
    border: 1px solid oklch(0.767 0.07 280 / 0.5);
    padding: 1px 4px;
    border-radius: 4px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: middle;
  }
  .nav-linkedin {
    margin-left: 8px;
    padding: 6px 14px;
    border-radius: 9999px;
    border: 1px solid var(--border-strong);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .nav-linkedin:hover { border-color: var(--teal); color: var(--teal); }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg);
    padding: 32px 24px;
  }
  .site-footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .footer-tagline { font-size: 0.7rem; color: var(--ink-5); }
  .footer-links { display: flex; gap: 20px; font-size: 0.75rem; }
  .footer-links a {
    color: var(--ink-4);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-links a:hover { color: var(--teal); }

  @media (max-width: 760px) {
    .site-header-inner {
      height: auto;
      flex-wrap: wrap;
      row-gap: 10px;
      padding-top: 12px;
      padding-bottom: 12px;
    }
    .site-nav {
      flex-wrap: wrap;
      gap: 4px 6px;
      row-gap: 6px;
    }
    .nav-linkedin { margin-left: 0; }
  }
</style>
