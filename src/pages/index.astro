---
// Homepage. One message: Peter builds data products from messy public data,
// and Recompete Radar is the main one. Everything else is secondary.
// Story text is copied from the stories' own headlines and findings.
import BaseLayout from "../layouts/BaseLayout.astro";
import HireBridge from "../components/HireBridge.astro";

const latestStory = {
  href: "/stories/contracts-coming-due/",
  title: "$62.9 billion in federal work comes up for grabs in the next 12 months",
  finding:
    "11,794 contracts at 20 civilian agencies reach the end of their final period by November 2027, and a quarter of the money ends in a single month: September.",
  asOfLabel: "Nov. 8, 2026",
};

const products = [
  {
    kind: "Data stories",
    title: "Interactive stories on what the data shows",
    desc: "Short pieces that ask one question and answer it with charts: contracts coming due, and who does HHS's contract work.",
    cta: "See the stories",
    href: "/recompete-radar#stories",
    external: false,
  },
  {
    kind: "Analytical brief",
    title: "Four traps in public contract data",
    desc: "The data problems that would have produced confident, wrong numbers, and how each one was found and fixed.",
    cta: "Read the brief",
    href: "/projects/sunlight-recompete-radar#brief",
    external: false,
  },
  {
    kind: "Live app",
    title: "Search expiring contracts yourself",
    desc: "Browse ranked contracts by agency and vendor, with the factors behind each score.",
    cta: "Open the app",
    href: "https://recompete-radar.vercel.app/",
    external: true,
  },
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero-mesh hero">
    <div class="wrap">
      <div class="hero-badges">
        <span class="hero-badge hero-badge-teal">Northern Virginia · DMV</span>
        <span class="hero-badge hero-badge-amber">Open to full-time roles</span>
      </div>
      <h1 class="hero-title">I build data products from messy public data.</h1>
      <p class="hero-lede">
        My main one is <strong>Recompete Radar</strong>. It tracks which federal contracts are about
        to be re-bid, who holds them, and how entrenched they are, and turns that into stories,
        briefs and a searchable app.
      </p>
      <div class="hero-cta">
        <a href="#radar" class="btn-primary btn-amber">See what it produces</a>
        <a href="/resume" class="btn-outline">View resume</a>
        <a href="mailto:Peter.H.Hagen@gmail.com" class="btn-outline">Contact Peter</a>
      </div>
      <p class="hero-roles">
        Looking for: Data Engineer · Analytics Engineer · BI Engineer · Implementation / Technical Operations
      </p>
    </div>
  </section>

  <!-- WHAT RADAR PRODUCES -->
  <section id="radar" class="section amber-mesh anchor-target">
    <div class="wrap">
      <div class="eyebrow">Recompete Radar</div>
      <h2 class="sec-title">What it produces</h2>

      <a href={latestStory.href} class="card lead-card reveal">
        <div class="lead-meta">
          <span class="badge badge-live">Latest story</span>
          <span class="lead-asof">Data as of {latestStory.asOfLabel}</span>
        </div>
        <div class="lead-title">{latestStory.title}</div>
        <p class="lead-finding">{latestStory.finding}</p>
        <span class="lead-go">Read the story →</span>
      </a>

      <div class="products">
        {products.map((p) => (
          <a
            href={p.href}
            class:list={["card", "product", "reveal", { "slow-demo-link": p.external }]}
            {...(p.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            <span class="product-kind">{p.kind}</span>
            <span class="product-title">{p.title}</span>
            <span class="product-desc">{p.desc}</span>
            <span class="product-go">{p.cta} {p.external ? "↗" : "→"}</span>
          </a>
        ))}
      </div>

      <p class="how">
        Built solo from 484,242 public contract records, cleaned and tested in Snowflake and dbt.
        <a href="/projects/sunlight-recompete-radar">How it's built, and its limits →</a>
      </p>
    </div>
  </section>

  <!-- BACKGROUND -->
  <section class="section bg-alt">
    <div class="wrap bg-grid">
      <div>
        <div class="eyebrow" style="margin-bottom: 8px;">Background</div>
        <h2 class="sec-title" style="margin-top: 0;">Real organizational data, not just portfolio projects</h2>
      </div>
      <div class="bg-items">
        <div>
          <div class="org">National Association of Home Builders</div>
          <p>
            Senior Data Analyst, previously Director, Membership Data. Reporting, segmentation and
            data-quality work on <strong>114K+ member records</strong> for a national organization.
          </p>
        </div>
        <div>
          <div class="org">DGCI · Defense logistics &amp; procurement</div>
          <p>
            Supported DLA fuel contract bidding with procurement-facing analysis and
            executive-ready pricing recommendations.
          </p>
        </div>
        <p class="edu">
          M.S. Systems Engineering, George Mason University · B.S. Industrial &amp; Systems
          Engineering, Virginia Tech
        </p>
      </div>
    </div>
  </section>

  <!-- OTHER WORK -->
  <section class="section">
    <div class="wrap other">
      <div>
        <div class="eyebrow" style="margin-bottom: 6px;">Other work</div>
        <p>Pipelines, dashboards, a RAG app and D3 visualizations, kept as supporting examples.</p>
      </div>
      <a href="/projects" class="btn-outline">Browse other projects →</a>
    </div>
  </section>

  <HireBridge />
</BaseLayout>

<style>
  .anchor-target { scroll-margin-top: 70px; }

  .hero { padding: 72px 24px 64px; border-bottom: 1px solid var(--border); }
  .hero-badges { display: flex; gap: 8px; flex-wrap: wrap; }
  .hero-title {
    margin-top: 20px;
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 820px;
  }
  .hero-lede { margin-top: 18px; font-size: 1.0625rem; line-height: 1.7; color: var(--ink-2); max-width: 640px; }
  .hero-lede strong { color: var(--ink); }
  .hero-cta { margin-top: 26px; display: flex; gap: 10px; flex-wrap: wrap; }
  .hero-roles { margin-top: 22px; font-size: 0.75rem; color: var(--ink-3); }

  .sec-title {
    margin-top: 6px;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1.2;
  }

  .lead-card { display: flex; flex-direction: column; gap: 10px; margin-top: 22px; padding: 28px 30px; text-decoration: none; }
  .lead-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .lead-asof { font-size: 0.75rem; color: var(--ink-3); }
  .lead-title { font-family: var(--font-serif); font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 700; line-height: 1.2; color: var(--ink); max-width: 780px; }
  .lead-finding { font-size: 0.95rem; line-height: 1.65; color: var(--ink-2); max-width: 700px; }
  .lead-go { font-size: 0.875rem; font-weight: 700; color: var(--teal-text); }
  .lead-card:hover .lead-title { color: var(--teal-text); }

  .products { margin-top: 16px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .product { display: flex; flex-direction: column; gap: 8px; padding: 20px 22px; text-decoration: none; }
  .product-kind { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--amber); }
  .product-title { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 700; line-height: 1.3; color: var(--ink); }
  .product-desc { font-size: 0.82rem; line-height: 1.6; color: var(--ink-2); }
  .product-go { margin-top: auto; padding-top: 6px; font-size: 0.8125rem; font-weight: 700; color: var(--teal-text); }

  .how { margin-top: 22px; font-size: 0.85rem; line-height: 1.6; color: var(--ink-3); }
  .how a { color: var(--teal-text); font-weight: 600; text-decoration: none; white-space: nowrap; }
  .how a:hover { color: var(--teal-hover); }

  .bg-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; align-items: start; }
  .bg-items { display: flex; flex-direction: column; gap: 18px; }
  .org { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal-text); margin-bottom: 4px; }
  .bg-items p { font-size: 0.875rem; line-height: 1.65; color: var(--ink-2); }
  .bg-items strong { color: var(--ink); }
  .bg-items p.edu { font-size: 0.75rem; color: var(--ink-3); }

  .other { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .other p { font-size: 0.875rem; color: var(--ink-2); }

  @media (max-width: 860px) {
    .products { grid-template-columns: 1fr; }
    .bg-grid { grid-template-columns: 1fr; gap: 16px; }
  }
  @media (max-width: 760px) {
    .hero { padding: 48px 18px 44px; }
    .section { padding-left: 18px; padding-right: 18px; }
    .lead-card { padding: 22px; }
  }
</style>
