---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SkillsOverview from "../components/SkillsOverview.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");

// Feature the projects with the clearest hiring signal first
const featuredSlugs = [
  "sunlight-recompete-radar",
  "govcon-procurement-dashboard",
  "obsidian-rag-chat",
  "ai-pipeline-operational-insights",
  "financial-analysis-april",
  "nova-data-center-energy",
  "supply-chain-petri-net",
  "macro-system-dynamics",
];

const featuredProjects = featuredSlugs
  .map((slug) => allProjects.find((p) => p.slug === slug))
  .filter(Boolean)
  .map((project) => ({
    title: project.data.title,
    slug: project.slug,
    type: project.data.type,
    summary: project.data.summary,
    tags: project.data.tags || [],
  }));
---

<BaseLayout>
  <Hero />

  <section class="border-b border-slate-800 bg-slate-950">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <header class="mb-6 space-y-1">
        <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-300">At a glance</h2>
        <p class="text-sm text-slate-400">What I do, how I work, and what roles are the best fit.</p>
      </header>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4">
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-300">What I build</h2>
          <p class="mt-2 text-sm text-slate-300">Data pipelines and reporting layers that make messy operational data more usable.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4">
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-300">How I work</h2>
          <p class="mt-2 text-sm text-slate-300">Systems-minded, SQL/Python-heavy, and focused on clear decision support rather than dashboard theater.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4">
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-300">Best fit</h2>
          <p class="mt-2 text-sm text-slate-300">Data Engineer, Analytics Engineer, BI Engineer, and adjacent AI/data workflow roles.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4">
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-300">What stands out</h2>
          <p class="mt-2 text-sm text-slate-300">RAG workflows, stakeholder-facing analytics, D3 storytelling, and project work with real personality.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-800 bg-slate-900">
    <div class="mx-auto grid max-w-5xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[1.2fr_0.8fr] lg:px-8">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-300">Open to</h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base">
          Data Engineer, Analytics Engineer, BI Engineer, and AI/data infrastructure roles where the job is to make messy operational data usable. Strongest fit: teams that need someone who can move between SQL/Python implementation, stakeholder-facing analytics, and clear written explanation.
        </p>
      </div>
      <div class="grid gap-3 text-sm text-slate-300">
        <div class="border-l border-teal-400/60 pl-4">
          <p class="font-semibold text-slate-100">DMV / DC / Northern Virginia</p>
          <p class="mt-1 text-xs text-slate-400">GovCon, finance, infrastructure, healthcare, SaaS, and mission-oriented data teams.</p>
        </div>
        <div class="border-l border-teal-400/60 pl-4">
          <p class="font-semibold text-slate-100">Immediate proof points</p>
          <p class="mt-1 text-xs text-slate-400">Sunlight recompete radar, procurement BI, RAG workflows, market research automation, and D3 infrastructure storytelling.</p>
        </div>
      </div>
    </div>
  </section>

  <SkillsOverview />
  <ProjectGrid projects={featuredProjects} />

  <section class="border-b border-slate-800 bg-slate-950">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
      <header class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-300">
            Live Projects
          </h2>
          <p class="mt-1 text-sm text-slate-400">Deployed and runnable — click any to explore.</p>
        </div>
        <a
          href="/projects#live-projects"
          class="shrink-0 text-xs font-semibold text-teal-300 hover:text-teal-200"
        >
          View all live projects →
        </a>
      </header>
      <div class="divide-y divide-slate-800">
        <div class="py-4 first:pt-0">
          <a
            href="https://obsidian-rag-7fzsf7xqbrkgxqw3c7xh2g.streamlit.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-baseline gap-1.5 text-sm font-medium text-slate-100 hover:text-teal-300"
          >
            <span>Obsidian RAG Chat</span>
            <span class="text-slate-400 group-hover:text-teal-300">↗</span>
          </a>
          <p class="mt-0.5 text-xs text-slate-400">
            Search and chat with an Obsidian vault through a citation-grounded RAG pipeline built on semantic chunking, embeddings, and vector retrieval
          </p>
        </div>
        <div class="py-4">
          <a
            href="https://beltway-realms-card-db-production.up.railway.app"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-baseline gap-1.5 text-sm font-medium text-slate-100 hover:text-teal-300"
          >
            <span>Beltway Realms Card Database</span>
            <span class="text-slate-400 group-hover:text-teal-300">↗</span>
          </a>
          <p class="mt-0.5 text-xs text-slate-400">
            Full-stack card database with SQLite FTS5 search, comparison flows, recommendation logic, and a synergy-aware loadout builder
          </p>
        </div>
        <div class="py-4">
          <a
            href="https://ai-job-market-dashboard.vercel.app/projects/job-market-dashboard"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-baseline gap-1.5 text-sm font-medium text-slate-100 hover:text-teal-300"
          >
            <span>AI Job Market Intelligence Dashboard</span>
            <span class="text-slate-400 group-hover:text-teal-300">↗</span>
          </a>
          <p class="mt-0.5 text-xs text-slate-400">
            Job-market analytics project tracking AI hiring trends, skill demand, and market momentum through aggregated posting data
          </p>
        </div>
        <div class="py-4">
          <a
            href="/projects/low-fodmap-scientific-review"
            class="group inline-flex items-baseline gap-1.5 text-sm font-medium text-slate-100 hover:text-teal-300"
          >
            <span>Low FODMAP Diet — Scientific Review</span>
            <span class="text-slate-400 group-hover:text-teal-300">↗</span>
          </a>
          <p class="mt-0.5 text-xs text-slate-400">
            Evidence-based R Markdown review translating clinical nutrition research into a clearer, reproducible report.
          </p>
        </div>
        <div class="py-4">
          <a
            href="https://phizou.github.io/DMV-Company-Research-Vault/"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-baseline gap-1.5 text-sm font-medium text-slate-100 hover:text-teal-300"
          >
            <span>DMV Company Research Vault</span>
            <span class="text-slate-400 group-hover:text-teal-300">↗</span>
          </a>
          <p class="mt-0.5 text-xs text-slate-400">
            Public research vault mapping DMV tech, GovCon, and infrastructure companies through a structured Obsidian knowledge base
          </p>
        </div>
        <div class="py-4">
          <a
            href="https://nova-data-center-energy.vercel.app"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-baseline gap-1.5 text-sm font-medium text-slate-100 hover:text-teal-300"
          >
            <span>NOVA Data Center Energy</span>
            <span class="text-slate-400 group-hover:text-teal-300">↗</span>
          </a>
          <p class="mt-0.5 text-xs text-slate-400">
            D3 scrollytelling project translating public infrastructure data into a clearer view of Northern Virginia's data center boom
          </p>
        </div>
        <div class="py-4">
          <a
            href="https://iran-us-conflict-map2.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-baseline gap-1.5 text-sm font-medium text-slate-100 hover:text-teal-300"
          >
            <span>Iran–US Conflict Map</span>
            <span class="text-slate-400 group-hover:text-teal-300">↗</span>
          </a>
          <p class="mt-0.5 text-xs text-slate-400">
            Interactive D3 map tracking strikes, naval engagements, oil disruption, and humanitarian impact — day-by-day timeline
          </p>
        </div>
        <div class="py-4">
          <a
            href="https://beltway-realms-game.vercel.app"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-baseline gap-1.5 text-sm font-medium text-slate-100 hover:text-teal-300"
          >
            <span>Beltway Realms</span>
            <span class="text-slate-400 group-hover:text-teal-300">↗</span>
          </a>
          <p class="mt-0.5 text-xs text-slate-400">
            Experimental portfolio world that turns regional identity, projects, and storytelling into a game-like front-end experience
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
