---
// Homepage. One message: Peter builds data products from messy public data,
// and Recompete Radar is the main one. Everything else is secondary.
// Story text is copied from the stories' own headlines and findings.
import BaseLayout from "../layouts/BaseLayout.astro";
import HireBridge from "../components/HireBridge.astro";
import StoryCard from "../components/StoryCard.astro";

const latestStory = {
  href: "/stories/contracts-coming-due/",
  title: "$62.9 billion in federal work comes up for grabs in the next 12 months",
  finding:
    "11,794 contracts at 20 civilian agencies reach the end of their final period by November 2027, and a quarter of the money ends in a single month: September.",
  asOfLabel: "Nov. 8, 2026",
  asOf: "2026-11-08",
  image: "/stories/contracts-coming-due/og-image.jpg",
  imageAlt: "Monthly contract dollars, with the largest bar in September.",
};

const products = [
  {
    kind: "Analytical brief",
    title: "Four traps in public contract data",
    desc: "What went wrong in the source data, how I caught it, and what changed after the fixes.",
    image: "/images/recompete-radar/brief-preview.webp",
    imageAlt: "An excerpt from the brief showing the date-parser fix and the restored dates.",
    imageClass: "brief-image",
    cta: "Read the brief",
    href: "/projects/sunlight-recompete-radar#brief",
    external: false,
  },
  {
    kind: "Live app",
    title: "Explore the contract data",
    desc: "Filter contracts by agency or vendor and see the factors behind their rankings.",
    image: "/images/recompete-radar/app-preview.webp",
    imageAlt: "The live app, with contract filters and a ranked table of results.",
    imageClass: "app-image",
    cta: "Open the app",
    href: "https://recompete-radar.vercel.app/",
    external: true,
  },
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero-mesh hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
      <div class="hero-badges">
        <span class="hero-badge hero-badge-teal">Northern Virginia · DMV</span>
        <span class="hero-badge hero-badge-amber">Open to full-time roles</span>
      </div>
      <h1 class="hero-title">I build data products from messy public data.</h1>
      <p class="hero-lede">
        I turn difficult source data into tested datasets, clear analysis and tools people can
        use. My main project, <strong>Recompete Radar</strong>, brings that work together through
        federal contracting data.
      </p>
      <div class="hero-cta">
        <a href="/recompete-radar" class="btn-primary btn-amber">Explore Recompete Radar</a>
        <a href="/resume" class="btn-outline">View resume</a>
        <a href="mailto:Peter.H.Hagen@gmail.com" class="hero-contact">Contact Peter →</a>
      </div>
      <p class="hero-roles">
        Data engineering · Analytics · Implementation &amp; technical operations
      </p>
      </div>
      <div class="hero-story">
        <StoryCard {...latestStory} label="Latest from Recompete Radar" headingLevel="h2" eager />
      </div>
    </div>
  </section>

  <!-- WHAT RADAR PRODUCES -->
  <section id="radar" class="section amber-mesh anchor-target">
    <div class="wrap">
      <div class="eyebrow">Recompete Radar</div>
      <div class="section-heading">
        <div>
          <h2 class="sec-title">Explore the project</h2>
          <p class="section-intro">The analysis behind the stories, and the tool built from the same data.</p>
        </div>
        <a href="/recompete-radar#stories" class="text-link">All data stories →</a>
      </div>

      <div class="products">
        {products.map((p) => (
          <a
            href={p.href}
            class:list={["product", "reveal", { "slow-demo-link": p.external }]}
            {...(p.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            <div class:list={["product-art", p.imageClass]}>
              <img src={p.image} alt={p.imageAlt} width="1280" height="720" loading="lazy" decoding="async" />
            </div>
            <div class="product-copy">
            <span class="product-kind">{p.kind}</span>
            <h3 class="product-title">{p.title}</h3>
            <span class="product-desc">{p.desc}</span>
            <span class="product-go">{p.cta} {p.external ? "↗" : "→"}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="technical">
        <a href="/recompete-radar/architecture/" class="technical-image" aria-label="Explore the system schematics">
          <img src="/recompete-radar/architecture/og-image.png" alt="A block diagram tracing public data through the warehouse to the web app." width="1200" height="630" loading="lazy" />
        </a>
        <div>
          <h3>Want to see how it works?</h3>
          <p>I built the pipeline, data checks and scoring behind these outputs, working with 484,242 public contract records.</p>
          <div class="technical-links">
            <a href="/projects/sunlight-recompete-radar" class="text-link">Case study &amp; limits →</a>
            <a href="/recompete-radar/architecture/" class="text-link">Interactive schematics →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BACKGROUND -->
  <section class="section bg-alt">
    <div class="wrap bg-grid">
      <div>
        <div class="eyebrow" style="margin-bottom: 8px;">Background</div>
        <h2 class="sec-title" style="margin-top: 0;">Data work inside organizations.</h2>
      </div>
      <div class="bg-items">
        <div>
          <div class="org">National Association of Home Builders</div>
          <p>
            Senior Data Analyst, previously Director, Membership Data. Reporting, segmentation and
            data-quality work on <strong>114K+ member records</strong> for a national organization.
          </p>
        </div>
        <div>
          <div class="org">DGCI · Defense logistics &amp; procurement</div>
          <p>
            Supported DLA fuel contract bidding with procurement-facing analysis and
            executive-ready pricing recommendations.
          </p>
        </div>
        <p class="edu">
          M.S. Systems Engineering, George Mason University · B.S. Industrial &amp; Systems
          Engineering, Virginia Tech
        </p>
      </div>
    </div>
  </section>

  <!-- OTHER WORK -->
  <section class="section">
    <div class="wrap other">
      <div>
        <div class="eyebrow" style="margin-bottom: 6px;">Other work</div>
        <p>An archive of earlier projects, visual essays and experiments, collected over time.</p>
      </div>
      <a href="/projects" class="btn-outline">Browse the project archive →</a>
    </div>
  </section>

  <HireBridge />
</BaseLayout>

<style>
  .anchor-target { scroll-margin-top: 70px; }

  .hero { padding: 64px 24px 64px; border-bottom: 1px solid var(--border); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: 56px; }
  .hero-copy, .hero-story { min-width: 0; }
  .hero-badges { display: flex; gap: 8px; flex-wrap: wrap; }
  .hero-title {
    margin-top: 20px;
    font-size: clamp(2.2rem, 4.3vw, 3.3rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 820px;
    text-wrap: balance;
  }
  .hero-lede { margin-top: 18px; font-size: 1.0625rem; line-height: 1.7; color: var(--ink-2); max-width: 640px; }
  .hero-lede strong { color: var(--ink); }
  .hero-cta { margin-top: 26px; display: flex; gap: 10px; flex-wrap: wrap; }
  .hero-contact { padding: 8px 0; font-size: .8125rem; font-weight: 600; color: var(--teal-text); text-decoration: none; }
  .hero-roles { margin-top: 22px; font-size: 0.75rem; color: var(--ink-3); }

  .sec-title {
    margin-top: 6px;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1.2;
  }

  .section-heading { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 20px; }
  .section-intro { margin-top: 10px; font-size: .9375rem; line-height: 1.65; color: var(--ink-2); max-width: 560px; }
  .text-link { font-size: .8125rem; font-weight: 600; color: var(--teal-text); text-decoration: none; }
  .text-link:hover, .hero-contact:hover { text-decoration: underline; text-underline-offset: 4px; }
  .products { margin-top: 28px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .product { min-width: 0; display: flex; flex-direction: column; border-radius: 12px; background: var(--bg-card); box-shadow: 0 0 0 1px var(--border); overflow: hidden; text-decoration: none; transition: box-shadow .3s cubic-bezier(.16,1,.3,1); }
  .product:hover { box-shadow: 0 0 0 1px var(--border-strong), 0 12px 36px oklch(.42 .03 200 / .07); }
  .product-art { margin: 10px 10px 0; aspect-ratio: 1.9; overflow: hidden; border-radius: 5px; }
  .product-art img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .brief-image { background: var(--bg); display: flex; align-items: center; }
  .brief-image img { object-fit: contain; }
  .product-copy { display: flex; flex-direction: column; align-items: flex-start; flex: 1; gap: 10px; padding: 24px; }
  .product-kind { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--amber); }
  .product-title { font-family: var(--font-serif); font-size: 1.45rem; font-weight: 600; line-height: 1.2; color: var(--ink); }
  .product-desc { font-size: .9375rem; line-height: 1.65; color: var(--ink-2); }
  .product-go { margin-top: auto; padding-top: 10px; font-size: 0.8125rem; font-weight: 600; color: var(--teal-text); }

  .technical { display: grid; grid-template-columns: 220px minmax(0, 1fr); align-items: center; gap: 28px; margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--border); }
  .technical-image img { width: 100%; height: auto; border-radius: 5px; display: block; }
  .technical h3 { font-size: 1.25rem; font-weight: 600; color: var(--ink); }
  .technical p { margin-top: 6px; max-width: 600px; font-size: .875rem; line-height: 1.65; color: var(--ink-2); }
  .technical-links { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 12px; }
  .product:focus-visible, .technical-image:focus-visible, .text-link:focus-visible, .hero-contact:focus-visible { outline: 2px solid var(--teal-text); outline-offset: 5px; }

  .bg-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; align-items: start; }
  .bg-items { display: flex; flex-direction: column; gap: 18px; }
  .org { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal-text); margin-bottom: 4px; }
  .bg-items p { font-size: 0.875rem; line-height: 1.65; color: var(--ink-2); }
  .bg-items strong { color: var(--ink); }
  .bg-items p.edu { font-size: 0.75rem; color: var(--ink-3); }

  .other { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .other p { font-size: 0.875rem; color: var(--ink-2); }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: 32px; }
    .hero-copy { max-width: 640px; }
    .hero-story { max-width: 620px; }
    .bg-grid { grid-template-columns: 1fr; gap: 16px; }
  }
  @media (max-width: 760px) {
    .hero { padding: 48px 18px 44px; }
    .section { padding-left: 18px; padding-right: 18px; }
    .products { grid-template-columns: 1fr; gap: 24px; }
    .technical { grid-template-columns: 1fr; gap: 18px; }
    .technical-image { max-width: 300px; }
    .hero-title { font-size: clamp(2.2rem, 8vw, 3.2rem); }
    .product-copy { padding: 22px; }
  }
</style>
