---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const sortedPosts = [...posts].sort((a, b) => {
  const dateA = a.data.publishedAt ? new Date(a.data.publishedAt).getTime() : 0;
  const dateB = b.data.publishedAt ? new Date(b.data.publishedAt).getTime() : 0;
  return dateB - dateA;
});
---

<BaseLayout title="Blog – Peter Hagen">
  <section class="border-b border-slate-800 bg-slate-950">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
      <header class="mb-6 space-y-2">
        <h1 class="text-2xl font-semibold tracking-tight text-slate-50 sm:text-3xl">
          Blog
        </h1>
        <p class="max-w-2xl text-sm text-slate-300 sm:text-base">
          Notes, essays, and reports on data, analytics, health, and more.
        </p>
      </header>
      {sortedPosts.length > 0 ? (
        <ul class="space-y-3 text-sm text-slate-200 sm:text-base">
          {sortedPosts.map((post) => (
            <li>
              {post.data.externalUrl ? (
                <a href={post.data.externalUrl} class="text-slate-100 hover:text-teal-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 rounded">
                  {post.data.title}
                </a>
              ) : (
                <a href={`/blog/${post.slug}`} class="text-slate-100 hover:text-teal-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 rounded">
                  {post.data.title}
                </a>
              )}
              {post.data.summary && (
                <p class="text-xs text-slate-400">
                  {post.data.summary}
                </p>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-slate-400 italic">No posts yet. Check back soon!</p>
      )}
    </div>
  </section>
</BaseLayout>
