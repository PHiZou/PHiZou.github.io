---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectArticle from "../../components/projects/ProjectArticle.astro";

export async function getStaticPaths() {
  const { getCollection } = await import("astro:content");
  const projects = await getCollection("projects");
  // The flagship case study has its own hand-built page (sunlight-recompete-radar.astro).
  return projects.filter((project) => project.slug !== "sunlight-recompete-radar").map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
---

<BaseLayout title={`${data.title} – Project – Peter Hagen`} description={data.summary}>
  <ProjectArticle project={project} />
</BaseLayout>
