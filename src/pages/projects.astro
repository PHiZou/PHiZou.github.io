---
import BaseLayout from "../layouts/BaseLayout.astro";
import HireBridge from "../components/HireBridge.astro";

// Explicit editorial lists. A project not named here keeps its page but is
// not listed. Live links were checked on 2026-11-13.
const groups = [
  {
    persona: "Supporting projects",
    color: "var(--teal-text)",
    projects: [
      {
        title: "Mortgage Risk Observatory",
        desc: "A loan-performance pipeline over the Freddie Mac loan-level dataset: validated ingestion, tested dbt marts, quality gates and a dashboard.",
        status: "Code",
        url: "https://github.com/PHiZou/loan-performance-pipeline",
        caseStudy: null,
      },
      {
        title: "NOVA Data Center Energy",
        desc: "Utility filings and infrastructure data turned into a scrolling visual story about Northern Virginia's data centers.",
        status: "Live",
        url: "https://nova-data-center-v3.vercel.app",
        caseStudy: "/projects/nova-data-center-energy",
      },
      {
        title: "AI pipeline observability",
        desc: "Ingests pipeline run logs, flags failures and runtime spikes, and reports pipeline health.",
        status: "Case study",
        url: null,
        caseStudy: "/projects/ai-pipeline-observability",
      },
      {
        title: "Obsidian RAG Chat",
        desc: "Question answering over a notes vault, with every answer citing the notes it came from.",
        status: "Live",
        url: "https://obsidian-rag-7fzsf7xqbrkgxqw3c7xh2g.streamlit.app/",
        caseStudy: "/projects/obsidian-rag-chat",
      },
      {
        title: "The Yield Curve: An Interactive History",
        desc: "34 years of US Treasury yield curves, explorable through recessions and expansions.",
        status: "Live",
        url: "https://yield-curve-history.vercel.app",
        caseStudy: "/projects/yield-curve-history",
      },
      {
        title: "Fraud Risk Analyzer",
        desc: "A Bayesian network that scores transaction fraud risk and shows which factors moved the score.",
        status: "Live",
        url: "https://fraud-bayesian-analyzer.vercel.app",
        caseStudy: "/projects/fraud-bayesian-analyzer",
      },
      {
        title: "FlowState: Supply Chain Resilience Simulator",
        desc: "An eight-stage supply chain simulator for testing disruptions and finding bottlenecks.",
        status: "Live",
        url: "https://supply-chain-petri-net-phizou.vercel.app",
        caseStudy: "/projects/supply-chain-petri-net",
      },
    ],
  },
  {
    persona: "Earlier work",
    color: "var(--ink-4)",
    projects: [
      {
        title: "Federal Procurement Intelligence Dashboard",
        desc: "An earlier dashboard prototype that led to Recompete Radar. It runs on sample data.",
        status: "Sample data",
        url: "https://govcon-analytics-dashboard.vercel.app",
        caseStudy: "/projects/govcon-procurement-dashboard",
      },
      {
        title: "Macro System Dynamics",
        desc: "A causal loop diagram of the US economy with scenario shocks.",
        status: "Live",
        url: "https://macro-system-dynamics-phizou.vercel.app",
        caseStudy: "/projects/macro-system-dynamics",
      },
      {
        title: "Quant model for risk-aware forecasting",
        desc: "Forecasting and scenario analysis focused on uncertainty and downside risk.",
        status: "Case study",
        url: null,
        caseStudy: "/projects/quant-model-risk-forecasting",
      },
      {
        title: "Earlier D3 and Shiny visualizations",
        desc: "Demographics, regional patterns and sports data, including the Futbol League Explorer.",
        status: "Case study",
        url: null,
        caseStudy: "/projects/d3-visualizations-portfolio",
      },
      {
        title: "Daily AI News Poem Generator",
        desc: "A pipeline that turned daily news into short narrated poem videos. Ran in December 2025, now archived.",
        status: "Archived",
        url: null,
        caseStudy: "/projects/poem-generator",
      },
    ],
  },
];

const statusClass: Record<string, string> = {
  Live: "badge-live",
  Code: "badge-saas",
  "Case study": "badge-saas",
  "Sample data": "badge-premium",
  Archived: "badge-premium",
};
---

<BaseLayout
  title="Supporting projects – Peter Hagen"
  description="Supporting projects by Peter Hagen: data pipelines, analysis tools and visualizations. Recompete Radar is the main project."
>
  <section class="archive-hero">
    <div class="wrap">
      <div class="eyebrow" style="margin-bottom: 10px;">Projects</div>
      <h1>Supporting projects</h1>
      <p class="archive-intro">
        Smaller projects that show the same habits as Recompete Radar: test the data, explain
        the result, ship something people can use. Titles open the write-up. Launch links open
        the project itself.
      </p>
      <a href="/recompete-radar" class="card radar-banner">
        <span><strong>Start with Recompete Radar</strong>, the main project: data stories, an analytical brief and the pipeline behind them.</span>
        <span class="radar-banner-go">Go to Recompete Radar →</span>
      </a>
    </div>
  </section>

  <section style="padding: 32px 24px;">
    <div class="wrap" style="display: flex; flex-direction: column; gap: 32px;">
      {groups.map((group) => (
        <div>
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
            <div style={`width: 3px; height: 14px; background: ${group.color}; border-radius: 2px;`}></div>
            <div class="mono group-label">{group.persona}</div>
          </div>
          <div style="display: flex; flex-direction: column;">
            {group.projects.map((p) => (
              <div class="catalog-row reveal">
                <div style="flex: 1;">
                  {p.caseStudy ? (
                    <a href={p.caseStudy} class="catalog-title">{p.title}</a>
                  ) : p.url ? (
                    <a href={p.url} target="_blank" rel="noopener noreferrer" class="catalog-title">{p.title} ↗</a>
                  ) : (
                    <span class="catalog-title" style="cursor: default;">{p.title}</span>
                  )}
                  <span class="catalog-desc">{p.desc}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  {p.url && p.caseStudy && (
                    <a href={p.url} target="_blank" rel="noopener noreferrer" class="catalog-launch slow-demo-link">Launch ↗</a>
                  )}
                  <span class={"badge " + statusClass[p.status]}>{p.status}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

    </div>
  </section>

  <HireBridge />
</BaseLayout>

<style>
  .archive-hero { border-bottom: 1px solid var(--border); padding: 56px 24px 36px; }
  .archive-hero h1 { margin-bottom: 12px; font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 600; line-height: 1.1; color: var(--ink); }
  .archive-intro { max-width: 640px; font-size: .9375rem; line-height: 1.7; color: var(--ink-2); }
  .radar-banner { margin-top: 18px; padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; text-decoration: none; font-size: 0.85rem; color: var(--ink-2); }
  .radar-banner strong { color: var(--ink); }
  .radar-banner-go { font-weight: 700; color: var(--amber); white-space: nowrap; }
  .group-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .catalog-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    gap: 16px;
  }
  .catalog-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  a.catalog-title:hover { color: var(--teal-text); }
  .catalog-desc { display: block; margin-top: 4px; font-size: .8125rem; line-height: 1.6; color: var(--ink-3); }
  .catalog-launch {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--teal-text);
    text-decoration: none;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    section { padding-left: 18px; padding-right: 18px; }
    .catalog-row { flex-wrap: wrap; }
    .catalog-desc { display: block; margin-left: 0; margin-top: 2px; }
  }
</style>
