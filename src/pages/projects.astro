---
import BaseLayout from "../layouts/BaseLayout.astro";
import HireBridge from "../components/HireBridge.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");

const groups = [
  {
    persona: "Hiring manager? Start with these five",
    color: "var(--teal-text)",
    projects: [
      {
        title: "Sunlight — Federal Recompete Radar",
        desc: "End-to-end analytics engineering: ingest → Postgres → dbt → FastAPI → Next.js.",
        status: "Live",
        url: "https://sunlight-pi.vercel.app/",
        caseStudy: "/projects/sunlight-recompete-radar",
      },
      {
        title: "Obsidian RAG Chat",
        desc: "Citation-grounded RAG: semantic chunking, embeddings, vector retrieval.",
        status: "Live",
        url: "https://obsidian-rag-7fzsf7xqbrkgxqw3c7xh2g.streamlit.app/",
        caseStudy: "/projects/obsidian-rag-chat",
      },
      {
        title: "Federal Procurement Intelligence Dashboard",
        desc: "Live USASpending API → full BI stack in one app.",
        status: "Live",
        url: "https://govcon-analytics-dashboard.vercel.app",
        caseStudy: "/projects/govcon-procurement-dashboard",
      },
      {
        title: "NOVA Data Center Energy",
        desc: "D3 scrollytelling on Northern Virginia infrastructure data.",
        status: "Live",
        url: "https://nova-data-center-energy.vercel.app",
        caseStudy: "/projects/nova-data-center-energy",
      },
      {
        title: "AWS Data Pipeline & Analytics",
        desc: "Batch architecture: S3, Lambda, Redshift, Airflow.",
        status: "Case study",
        url: null,
        caseStudy: "/projects/aws-data-pipeline-analytics",
      },
    ],
  },
  {
    persona: "GovCon / BD teams",
    color: "var(--amber)",
    projects: [
      {
        title: "Sunlight — Federal Recompete Radar",
        desc: "Recompete scoring on $1.25B of DHS obligated value.",
        status: "Live",
        url: "https://sunlight-pi.vercel.app/",
        caseStudy: "/projects/sunlight-recompete-radar",
      },
      {
        title: "DMV Company Research Vault",
        desc: "Knowledge graph of 200+ NOVA/DMV tech & GovCon companies.",
        status: "Live",
        url: "https://phizou.github.io/DMV-Company-Research-Vault/",
        caseStudy: null,
      },
      {
        title: "FY27 Defense Strategic Acquisition",
        desc: "Budget, pathways, and positioning analysis for FY2027.",
        status: "Case study",
        url: "https://fy27-defense-acquisition.vercel.app",
        caseStudy: "/projects/fy27-defense-acquisition",
      },
    ],
  },
  {
    persona: "Data engineering & AI",
    color: "var(--purple-text)",
    projects: [
      {
        title: "Obsidian RAG Chat",
        desc: "Production-shaped RAG pipeline with grounded citations.",
        status: "Live",
        url: "https://obsidian-rag-7fzsf7xqbrkgxqw3c7xh2g.streamlit.app/",
        caseStudy: "/projects/obsidian-rag-chat",
      },
      {
        title: "AWS Data Pipeline & Analytics",
        desc: "Cloud ETL architecture and orchestration.",
        status: "Case study",
        url: null,
        caseStudy: "/projects/aws-data-pipeline-analytics",
      },
      {
        title: "AI Job Market Intelligence",
        desc: "Aggregated posting data → skill demand and role velocity.",
        status: "Live",
        url: "https://ai-job-market-dashboard.vercel.app/projects/job-market-dashboard",
        caseStudy: null,
      },
    ],
  },
  {
    persona: "BI, analytics & visualization",
    color: "var(--red-text)",
    projects: [
      {
        title: "Federal Procurement Intelligence Dashboard",
        desc: "Agency spend, contractor leaderboards, acquisition trends.",
        status: "Live",
        url: "https://govcon-analytics-dashboard.vercel.app",
        caseStudy: "/projects/govcon-procurement-dashboard",
      },
      {
        title: "NOVA Data Center Energy",
        desc: "Public infrastructure data made legible via scrollytelling.",
        status: "Live",
        url: "https://nova-data-center-energy.vercel.app",
        caseStudy: "/projects/nova-data-center-energy",
      },
      {
        title: "Iran Conflict Operational Intelligence Dashboard",
        desc: "Multi-view OSINT dashboard: escalation index, scenarios.",
        status: "Prototype",
        url: "https://iran-conflict-portfolio.vercel.app",
        caseStudy: "/projects/iran-conflict-dashboard",
      },
      {
        title: "Iran–US Conflict Map",
        desc: "D3 geographic conflict tracking, day-by-day timeline.",
        status: "Prototype",
        url: "https://iran-us-conflict-map2.vercel.app/",
        caseStudy: "/projects/iran-us-conflict-map",
      },
    ],
  },
];

const statusClass: Record<string, string> = {
  Live: "badge-live",
  "Case study": "badge-saas",
  Prototype: "badge-premium",
};

// Everything else in the content collection, so no case study becomes unreachable
const curatedSlugs = new Set(
  groups.flatMap((g) => g.projects.map((p) => p.caseStudy)).filter(Boolean)
    .map((path) => path!.replace("/projects/", ""))
);
const moreProjects = allProjects
  .filter((p) => !curatedSlugs.has(p.slug))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="All Projects – Peter Hagen"
  description="Pipelines, dashboards, RAG workflows, and procurement intelligence — most are live and clickable, each with a written case study."
>
  <section style="border-bottom: 1px solid var(--border); padding: 48px 24px 32px;">
    <div class="wrap">
      <div class="eyebrow" style="color: var(--ink-5); margin-bottom: 10px;">All projects</div>
      <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--ink); margin-bottom: 8px;">Selected work</h1>
      <p style="font-size: 0.8125rem; color: var(--ink-4);">
        Pipelines, dashboards, RAG workflows, and procurement intelligence — most are live and
        clickable. Project titles open the written case study; Launch opens the live app.
      </p>
    </div>
  </section>

  <section style="padding: 32px 24px;">
    <div class="wrap" style="display: flex; flex-direction: column; gap: 32px;">
      {groups.map((group) => (
        <div>
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
            <div style={`width: 3px; height: 14px; background: ${group.color}; border-radius: 2px;`}></div>
            <div class="mono group-label">{group.persona}</div>
          </div>
          <div style="display: flex; flex-direction: column;">
            {group.projects.map((p) => (
              <div class="catalog-row reveal">
                <div style="flex: 1;">
                  {p.caseStudy ? (
                    <a href={p.caseStudy} class="catalog-title">{p.title}</a>
                  ) : p.url ? (
                    <a href={p.url} target="_blank" rel="noopener noreferrer" class="catalog-title">{p.title} ↗</a>
                  ) : (
                    <span class="catalog-title" style="cursor: default;">{p.title}</span>
                  )}
                  <span class="catalog-desc">{p.desc}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  {p.url && p.caseStudy && (
                    <a href={p.url} target="_blank" rel="noopener noreferrer" class="catalog-launch">Launch ↗</a>
                  )}
                  <span class={"badge " + statusClass[p.status]}>{p.status}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      {moreProjects.length > 0 && (
        <div>
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
            <div style="width: 3px; height: 14px; background: var(--ink-4); border-radius: 2px;"></div>
            <div class="mono group-label">More builds & case studies</div>
          </div>
          <div style="display: flex; flex-direction: column;">
            {moreProjects.map((p) => (
              <div class="catalog-row reveal">
                <div style="flex: 1;">
                  <a href={`/projects/${p.slug}`} class="catalog-title">{p.data.title}</a>
                  <span class="catalog-desc">{p.data.type}</span>
                </div>
                {p.data.liveUrl && (
                  <a href={p.data.liveUrl} target="_blank" rel="noopener noreferrer" class="catalog-launch">Launch ↗</a>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <HireBridge />
</BaseLayout>

<style>
  .group-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-4);
  }
  .catalog-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
    gap: 16px;
  }
  .catalog-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  a.catalog-title:hover { color: var(--teal-text); }
  .catalog-desc { margin-left: 12px; font-size: 0.72rem; color: var(--ink-5); }
  .catalog-launch {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--teal-text);
    text-decoration: none;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    section { padding-left: 18px; padding-right: 18px; }
    .catalog-row { flex-wrap: wrap; }
    .catalog-desc { display: block; margin-left: 0; margin-top: 2px; }
  }
</style>
