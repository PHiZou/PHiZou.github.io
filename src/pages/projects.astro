---
import BaseLayout from "../layouts/BaseLayout.astro";
import HireBridge from "../components/HireBridge.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");

const groups = [
  {
    persona: "Selected earlier work",
    color: "var(--teal-text)",
    projects: [
      {
        title: "Obsidian RAG Chat",
        desc: "Citation-grounded RAG: semantic chunking, embeddings, vector retrieval.",
        status: "Live",
        url: "https://obsidian-rag-7fzsf7xqbrkgxqw3c7xh2g.streamlit.app/",
        caseStudy: "/projects/obsidian-rag-chat",
      },
      {
        title: "Federal Procurement Intelligence Dashboard",
        desc: "Live USASpending API → full BI stack in one app.",
        status: "Live",
        url: "https://govcon-analytics-dashboard.vercel.app",
        caseStudy: "/projects/govcon-procurement-dashboard",
      },
      {
        title: "NOVA Data Center Energy",
        desc: "D3 scrollytelling on Northern Virginia infrastructure data.",
        status: "Live",
        url: "https://nova-data-center-energy.vercel.app",
        caseStudy: "/projects/nova-data-center-energy",
      },
    ],
  },
  {
    persona: "Research & analysis",
    color: "var(--amber)",
    projects: [
      {
        title: "DMV Company Research Vault",
        desc: "Knowledge graph of 20+ NOVA/DMV tech & GovCon companies.",
        status: "Live",
        url: "https://phizou.github.io/DMV-Company-Research-Vault/",
        caseStudy: null,
      },
      {
        title: "FY27 Defense Strategic Acquisition",
        desc: "Budget, pathways, and positioning analysis for FY2027.",
        status: "Case study",
        url: "https://fy27-defense-acquisition.vercel.app",
        caseStudy: "/projects/fy27-defense-acquisition",
      },
    ],
  },
  {
    persona: "Search & data applications",
    color: "var(--purple-text)",
    projects: [
      {
        title: "Obsidian RAG Chat",
        desc: "RAG pipeline with grounded citations.",
        status: "Live",
        url: "https://obsidian-rag-7fzsf7xqbrkgxqw3c7xh2g.streamlit.app/",
        caseStudy: "/projects/obsidian-rag-chat",
      },
      {
        title: "AI Job Market Intelligence",
        desc: "Aggregated posting data → skill demand and role velocity.",
        status: "Live",
        url: "https://ai-job-market-dashboard.vercel.app/projects/job-market-dashboard",
        caseStudy: null,
      },
    ],
  },
  {
    persona: "Dashboards & visualizations",
    color: "var(--red-text)",
    projects: [
      {
        title: "Federal Procurement Intelligence Dashboard",
        desc: "Agency spend, contractor leaderboards, acquisition trends.",
        status: "Live",
        url: "https://govcon-analytics-dashboard.vercel.app",
        caseStudy: "/projects/govcon-procurement-dashboard",
      },
      {
        title: "NOVA Data Center Energy",
        desc: "Public infrastructure data made legible via scrollytelling.",
        status: "Live",
        url: "https://nova-data-center-energy.vercel.app",
        caseStudy: "/projects/nova-data-center-energy",
      },
      {
        title: "Iran Conflict Operational Intelligence Dashboard",
        desc: "Multi-view OSINT dashboard: escalation index, scenarios.",
        status: "Prototype",
        url: "https://iran-conflict-portfolio.vercel.app",
        caseStudy: "/projects/iran-conflict-dashboard",
      },
      {
        title: "Iran–US Conflict Map",
        desc: "D3 geographic conflict tracking, day-by-day timeline.",
        status: "Prototype",
        url: "https://iran-us-conflict-map2.vercel.app/",
        caseStudy: "/projects/iran-us-conflict-map",
      },
    ],
  },
];

const statusClass: Record<string, string> = {
  Live: "badge-live",
  "Case study": "badge-saas",
  Prototype: "badge-premium",
};

// Each project appears once in the archive, even when it spans several topics.
const seenProjects = new Set<string>();
const archiveGroups = groups.map((group) => ({
  ...group,
  projects: group.projects.filter((project) => {
    const key = project.caseStudy ?? project.url;
    if (seenProjects.has(key)) return false;
    seenProjects.add(key);
    return true;
  }),
})).filter((group) => group.projects.length > 0);

// Everything else in the content collection, so no case study becomes unreachable
const curatedSlugs = new Set(
  groups.flatMap((g) => g.projects.map((p) => p.caseStudy)).filter(Boolean)
    .map((path) => path!.replace("/projects/", ""))
);
const moreProjects = allProjects
  .filter((p) => !curatedSlugs.has(p.slug) && p.slug !== "sunlight-recompete-radar")
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Project archive – Peter Hagen"
  description="Earlier projects, visual essays and experiments by Peter Hagen. Browse applications, research and data visualizations; explore Recompete Radar for the main project."
>
  <section class="archive-hero">
    <div class="wrap">
      <div class="eyebrow" style="margin-bottom: 10px;">Other work</div>
      <h1>Project archive</h1>
      <p class="archive-intro">
        Earlier applications, visual essays and experiments, kept here to explore and reference.
        Project titles open the case study; demo links open the project itself.
      </p>
      <a href="/recompete-radar" class="card radar-banner">
        <span><strong>Start with Recompete Radar</strong> for the main project: data stories, the analytical brief and a working app.</span>
        <span class="radar-banner-go">Go to Recompete Radar →</span>
      </a>
    </div>
  </section>

  <section style="padding: 32px 24px;">
    <div class="wrap" style="display: flex; flex-direction: column; gap: 32px;">
      {archiveGroups.map((group) => (
        <div>
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
            <div style={`width: 3px; height: 14px; background: ${group.color}; border-radius: 2px;`}></div>
            <div class="mono group-label">{group.persona}</div>
          </div>
          <div style="display: flex; flex-direction: column;">
            {group.projects.map((p) => (
              <div class="catalog-row reveal">
                <div style="flex: 1;">
                  {p.caseStudy ? (
                    <a href={p.caseStudy} class="catalog-title">{p.title}</a>
                  ) : p.url ? (
                    <a href={p.url} target="_blank" rel="noopener noreferrer" class="catalog-title">{p.title} ↗</a>
                  ) : (
                    <span class="catalog-title" style="cursor: default;">{p.title}</span>
                  )}
                  <span class="catalog-desc">{p.desc}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  {p.url && p.caseStudy && (
                    <a href={p.url} target="_blank" rel="noopener noreferrer" class="catalog-launch slow-demo-link">Launch ↗</a>
                  )}
                  <span class={"badge " + statusClass[p.status]}>{p.status}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      {moreProjects.length > 0 && (
        <div>
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
            <div style="width: 3px; height: 14px; background: var(--ink-4); border-radius: 2px;"></div>
            <div class="mono group-label">More from the archive</div>
          </div>
          <div style="display: flex; flex-direction: column;">
            {moreProjects.map((p) => (
              <div class="catalog-row reveal">
                <div style="flex: 1;">
                  <a href={`/projects/${p.slug}`} class="catalog-title">{p.data.title}</a>
                  <span class="catalog-desc">{p.data.type}</span>
                </div>
                {p.data.liveUrl && (
                  <a href={p.data.liveUrl} target="_blank" rel="noopener noreferrer" class="catalog-launch slow-demo-link">Launch ↗</a>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <HireBridge />
</BaseLayout>

<style>
  .archive-hero { border-bottom: 1px solid var(--border); padding: 56px 24px 36px; }
  .archive-hero h1 { margin-bottom: 12px; font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 600; line-height: 1.1; color: var(--ink); }
  .archive-intro { max-width: 640px; font-size: .9375rem; line-height: 1.7; color: var(--ink-2); }
  .radar-banner { margin-top: 18px; padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; text-decoration: none; font-size: 0.85rem; color: var(--ink-2); }
  .radar-banner strong { color: var(--ink); }
  .radar-banner-go { font-weight: 700; color: var(--amber); white-space: nowrap; }
  .group-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .catalog-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    gap: 16px;
  }
  .catalog-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  a.catalog-title:hover { color: var(--teal-text); }
  .catalog-desc { display: block; margin-top: 4px; font-size: .8125rem; line-height: 1.6; color: var(--ink-3); }
  .catalog-launch {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--teal-text);
    text-decoration: none;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    section { padding-left: 18px; padding-right: 18px; }
    .catalog-row { flex-wrap: wrap; }
    .catalog-desc { display: block; margin-left: 0; margin-top: 2px; }
  }
</style>
