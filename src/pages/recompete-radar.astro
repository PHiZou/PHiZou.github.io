---
// Product hub for Recompete Radar: data stories, the brief / case study,
// and the live app. The stories are raw static files in public/stories/,
// served as-is; do not edit them here. Card text is copied from each
// story's own headline and findings; keep it in sync if a story changes.
import BaseLayout from "../layouts/BaseLayout.astro";
import HireBridge from "../components/HireBridge.astro";
import StoryCard from "../components/StoryCard.astro";

// Newest first.
const stories = [
  {
    href: "/stories/contracts-coming-due/",
    title: "$62.9 billion in federal work comes up for grabs in the next 12 months",
    finding:
      "11,794 contracts at 20 civilian agencies reach the end of their final period by November 2027, and a quarter of the money ends in a single month: September.",
    asOf: "2026-11-08",
    asOfLabel: "Nov. 8, 2026",
    image: "/stories/contracts-coming-due/og-image.jpg",
    imageAlt: "A monthly breakdown of contract dollars, showing the September concentration.",
  },
  {
    href: "/stories/hhs-contracting/",
    title: "Medicare’s machinery runs on contractors",
    finding:
      "CMS takes 44% of HHS contract dollars from just 6% of its awards, and spreads that work across more than 900 vendors.",
    asOf: "2026-11-04",
    asOfLabel: "Nov. 4, 2026",
    image: "/stories/hhs-contracting/og-image.jpg",
    imageAlt: "Contract spending by HHS division, with CMS receiving the largest share.",
  },
].sort((a, b) => b.asOf.localeCompare(a.asOf));
---

<BaseLayout
  title="Recompete Radar – Peter Hagen"
  description="Federal contracting, explained with data. Data stories, an analytical brief and a live app built on Recompete Radar by Peter Hagen."
>
  <section class="hero-mesh rr-hero">
    <div class="wrap">
      <div class="eyebrow">Recompete Radar</div>
      <h1 class="rr-title">Federal contracting, explained with data.</h1>
      <p class="rr-lede">
        Which contracts are ending, which companies hold them, and what deserves a closer look?
        I built Recompete Radar to make those questions easier to explore, using 484,242 public
        contract records from 20 civilian agencies.
      </p>
      <p class="rr-role">My work: data collection, cleaning and testing, analysis, and the tools below.</p>
      <nav class="rr-jump" aria-label="On this page">
        <a href="#stories">Data stories</a>
        <a href="#brief">Brief &amp; case study</a>
        <a href="#schematics">System schematics</a>
        <a href="#app">Live app</a>
      </nav>
    </div>
  </section>

  <!-- STORIES -->
  <section id="stories" class="section anchor">
    <div class="wrap">
      <h2 class="rr-h2">Data stories</h2>
      <p class="rr-sub">Start with a question. Explore the answer through the charts.</p>
      <div class="rr-list">
        {stories.map((s, i) => (
          <StoryCard {...s} label={i === 0 ? "Latest story" : "Data story"} eager={i === 0} />
        ))}
      </div>
    </div>
  </section>

  <!-- BRIEF -->
  <section id="brief" class="section bg-alt anchor">
    <div class="wrap rr-split">
      <div>
        <h2 class="rr-h2">Brief &amp; case study</h2>
        <p class="rr-sub">
          <strong>Four traps in public contract data.</strong> Dates that disappeared, dollars
          counted twice, misleading bid counts and a score that needed rebuilding. See how I
          found each problem, tested a fix, and documented what the data can support.
        </p>
      </div>
      <div class="rr-actions">
        <a href="/projects/sunlight-recompete-radar#brief" class="btn-primary btn-amber">Read the brief</a>
        <a href="/projects/sunlight-recompete-radar#pipeline" class="btn-outline">How it's built</a>
      </div>
    </div>
  </section>

  <!-- SCHEMATICS -->
  <section id="schematics" class="section anchor">
    <div class="wrap rr-split">
      <div>
        <h2 class="rr-h2">System schematics</h2>
        <p class="rr-sub">
          Follow the data from source to web app. Step through a simulated refresh, trace how
          tables depend on each other, and explore the scoring and freshness checks.
        </p>
      </div>
      <div class="rr-actions">
        <a href="/recompete-radar/architecture/" class="btn-outline">See the schematics →</a>
      </div>
    </div>
  </section>

  <!-- APP -->
  <section id="app" class="section bg-alt anchor">
    <div class="wrap rr-split">
      <div>
        <h2 class="rr-h2">Live app</h2>
        <p class="rr-sub">
          Explore contracts approaching their end dates, filter by agency or vendor, and see
          what contributes to each ranking. The first load can take a few seconds.
        </p>
      </div>
      <div class="rr-actions">
        <a href="https://recompete-radar.vercel.app/" target="_blank" rel="noopener noreferrer" class="btn-primary slow-demo-link">Open the app ↗</a>
        <a href="https://github.com/PHiZou/recompete-radar" target="_blank" rel="noopener noreferrer" class="btn-outline">Code ↗</a>
      </div>
    </div>
  </section>

  <HireBridge note="Recompete Radar shows how Peter works: take a large, messy public dataset, test it, find the question worth asking, and answer it clearly." />
</BaseLayout>

<style>
  .anchor { scroll-margin-top: 70px; }
  .rr-hero { padding: 56px 24px 40px; border-bottom: 1px solid var(--border); }
  .rr-title {
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-top: 10px;
    max-width: 760px;
  }
  .rr-lede { margin-top: 14px; font-size: 1rem; line-height: 1.7; color: var(--ink-2); max-width: 660px; }
  .rr-role { margin-top: 14px; font-size: .8125rem; line-height: 1.6; color: var(--ink-3); max-width: 660px; }
  .rr-jump { margin-top: 22px; display: flex; gap: 8px 20px; flex-wrap: wrap; }
  .rr-jump a { font-size: 0.8125rem; font-weight: 700; color: var(--teal-text); text-decoration: none; }
  .rr-jump a:hover { color: var(--teal-hover); }

  .rr-h2 { font-size: clamp(1.35rem, 3vw, 1.75rem); font-weight: 700; color: var(--ink); letter-spacing: -0.01em; }
  .rr-sub { margin-top: 6px; font-size: 0.9rem; line-height: 1.65; color: var(--ink-2); max-width: 640px; }
  .rr-sub strong { color: var(--ink); }

  .rr-list { margin-top: 24px; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 28px; }

  .rr-split { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .rr-actions { display: flex; gap: 10px; flex-wrap: wrap; }

  @media (max-width: 760px) {
    .rr-hero { padding: 40px 18px 32px; }
    .section { padding-left: 18px; padding-right: 18px; }
    .rr-list { grid-template-columns: 1fr; }
  }
</style>
