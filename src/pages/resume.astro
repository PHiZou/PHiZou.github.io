---
import BaseLayout from "../layouts/BaseLayout.astro";

const whyInterview = [
  "Strong SQL/Python analytics foundation — pipelines, dbt modeling, reporting layers, and tested transformation logic.",
  "Works across data, business, and stakeholder needs — comfortable translating between analysts, operators, and leadership.",
  "GovCon, logistics, and procurement fluency from DLA fuel bid environments and federal procurement data work.",
  "Real organizational data experience: 114K+ member records at NAHB — CRM analytics, segmentation, data quality, stakeholder reporting.",
  "Builds full-stack proof-of-work: Sunlight is a working production system, not slideware.",
  "A fit for technical-commercial roles where data fluency and clear communication both matter.",
];

const dataRoles = [
  "Data Engineer",
  "Analytics Engineer",
  "BI Engineer",
  "Data Analyst",
  "Business Analyst",
  "AI/Data Workflow Engineer",
];

const commercialRoles = [
  "Implementation Specialist",
  "Solutions Consultant Associate",
  "Customer Success Analytics",
  "Sales Ops / RevOps Analyst",
  "GovCon Market / Procurement Analyst",
  "BD / Capture Data Analyst",
];

const bestProof = [
  {
    n: "01",
    t: "Sunlight — Federal Recompete Radar",
    d: "Full-stack GovCon analytics engineering",
    u: "/projects/sunlight-recompete-radar",
  },
  {
    n: "02",
    t: "NAHB membership data & reporting",
    d: "Real organizational data credibility — 114K+ records",
    u: null,
  },
  {
    n: "03",
    t: "Obsidian RAG Chat",
    d: "AI / document workflow capability",
    u: "/projects/obsidian-rag-chat",
  },
  {
    n: "04",
    t: "Federal Procurement Dashboard",
    d: "Public API + BI / storytelling",
    u: "/projects/govcon-procurement-dashboard",
  },
  {
    n: "05",
    t: "DMV Company Research Vault",
    d: "Market research & product thinking",
    u: "https://phizou.github.io/DMV-Company-Research-Vault/",
  },
];

const background = [
  {
    org: "National Association of Home Builders",
    role: "Director-level, Membership Data & Reporting",
    detail:
      "Reporting layers, dashboards, recurring analytics workflows, segmentation, and data products supporting leadership — 114K+ member records.",
  },
  {
    org: "DGCI — Defense logistics & procurement",
    role: "Analyst, DLA fuel contract bid support",
    detail:
      "Logistics constraints, procurement-facing analysis, and executive-ready pricing and business recommendations.",
  },
  {
    org: "George Mason University",
    role: "M.S. Systems Engineering",
    detail: "Systems methodology, decision analysis, modeling.",
  },
  {
    org: "Virginia Tech",
    role: "B.S. Industrial & Systems Engineering",
    detail: "Operations research, statistics, process optimization.",
  },
];
---

<BaseLayout
  title="Resume – Peter Hagen"
  description="Systems-minded data and analytics professional — SQL/Python, GovCon and procurement fluency, real organizational data experience, and full-stack proof-of-work projects."
>
  <section style="border-bottom: 1px solid var(--border); padding: 64px 24px 48px;">
    <div class="wrap-narrow">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
        <div class="pulse-dot"></div>
        <span class="kicker">Open to full-time roles · available now · NOVA/DMV</span>
      </div>
      <h1 style="font-size: clamp(1.75rem, 4vw, 2.2rem); font-weight: 700; color: var(--ink); margin-bottom: 12px;">
        Peter Hagen
      </h1>
      <p style="font-size: 0.9375rem; color: var(--ink-3); margin-bottom: 24px; line-height: 1.6;">
        Systems-minded data and analytics professional — SQL/Python, GovCon and procurement fluency,
        real organizational data experience, and full-stack proof-of-work projects.
      </p>
      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <a href="/pdf/Peter-Hagen-Resume.pdf" download class="btn-primary">Download resume (PDF)</a>
        <a href="mailto:Peter.H.Hagen@gmail.com" class="btn-outline">Contact Peter</a>
        <a href="https://www.linkedin.com/in/peterhagen123" target="_blank" rel="noopener noreferrer" class="btn-outline">LinkedIn ↗</a>
        <a href="https://github.com/PHiZou" target="_blank" rel="noopener noreferrer" class="btn-outline">GitHub ↗</a>
      </div>
    </div>
  </section>

  <section style="padding: 40px 24px;">
    <div class="wrap-narrow" style="display: flex; flex-direction: column; gap: 28px;">
      <div>
        <div class="resume-label">Why interview Peter</div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {whyInterview.map((b) => (
            <div style="display: flex; gap: 10px; align-items: flex-start;">
              <span style="color: var(--teal-text); flex-shrink: 0; margin-top: 1px;">▸</span>
              <span style="font-size: 0.8125rem; line-height: 1.65; color: var(--ink-3);">{b}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="divider"></div>

      <div>
        <div class="resume-label">Role fit — two lanes</div>
        <div class="lanes-grid">
          <div class="card" style="padding: 20px;">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--teal-text); margin-bottom: 10px;">
              Data & analytics roles
            </div>
            <div style="display: flex; flex-direction: column; gap: 6px;">
              {dataRoles.map((r) => (
                <div style="display: flex; gap: 8px; align-items: center;">
                  <span class="role-dot" style="background: var(--teal-text);"></span>
                  <span style="font-size: 0.78rem; color: var(--ink-2);">{r}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="card" style="padding: 20px;">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--amber); margin-bottom: 10px;">
              Technical-commercial roles
            </div>
            <div style="display: flex; flex-direction: column; gap: 6px;">
              {commercialRoles.map((r) => (
                <div style="display: flex; gap: 8px; align-items: center;">
                  <span class="role-dot" style="background: var(--amber);"></span>
                  <span style="font-size: 0.78rem; color: var(--ink-2);">{r}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
        <p style="font-size: 0.72rem; color: var(--ink-5); margin-top: 10px; line-height: 1.6;">
          On the commercial lane: no quota or sales-tooling claims — the fit is a data-fluent
          communicator who can research accounts, understand technical products, structure messy
          information, and turn business problems into credible first conversations.
        </p>
      </div>

      <div class="divider"></div>

      <div>
        <div class="resume-label">Best proof to review first</div>
        <div style="display: flex; flex-direction: column;">
          {bestProof.map((p) => (
            <div class="proof-row">
              <span class="mono" style="font-size: 0.7rem; color: var(--border-strong); font-weight: 500;">{p.n}</span>
              {p.u ? (
                <a
                  href={p.u}
                  target={p.u.startsWith("http") ? "_blank" : undefined}
                  rel={p.u.startsWith("http") ? "noopener noreferrer" : undefined}
                  class="proof-title"
                >
                  {p.t} →
                </a>
              ) : (
                <span class="proof-title" style="cursor: default;">{p.t}</span>
              )}
              <span style="font-size: 0.72rem; color: var(--ink-5); margin-left: auto;">{p.d}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="divider"></div>

      <div>
        <div class="resume-label">Background</div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          {background.map((item) => (
            <div style="padding-bottom: 12px; border-bottom: 1px solid var(--border);">
              <div style="font-size: 0.8125rem; font-weight: 600; color: var(--ink);">{item.org}</div>
              <div style="font-size: 0.72rem; color: var(--teal-text); margin-bottom: 4px;">{item.role}</div>
              <div style="font-size: 0.72rem; color: var(--ink-4); line-height: 1.6;">{item.detail}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="divider"></div>

      <div>
        <div class="resume-label">Full resume</div>
        <div class="pdf-frame">
          <iframe title="Peter Hagen Resume PDF" src="/pdf/Peter-Hagen-Resume.pdf" loading="lazy"></iframe>
        </div>
        <p class="sr-only">If the PDF does not display, please use the download button above.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-5);
    margin-bottom: 14px;
  }
  .lanes-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .role-dot { width: 4px; height: 4px; border-radius: 50%; flex-shrink: 0; }
  .proof-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .proof-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  a.proof-title:hover { color: var(--teal-text); }
  .pdf-frame {
    aspect-ratio: 8.5 / 11;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .pdf-frame iframe { width: 100%; height: 100%; border: 0; }
  @media (max-width: 760px) {
    .lanes-grid { grid-template-columns: 1fr; }
    section { padding-left: 18px; padding-right: 18px; }
    .proof-row { flex-wrap: wrap; }
  }
</style>
