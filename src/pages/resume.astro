---
import BaseLayout from "../layouts/BaseLayout.astro";

const whyInterview = [
  "SQL and Python for analysis and pipelines, with dbt models and tests that fail the build when a rule breaks.",
  "Real organizational data: 114K+ member records across 500+ local associations at NAHB, covering reporting, segmentation and data quality.",
  "Comfortable between analysts, operators and leadership, and able to explain the same number to each.",
  "Recompete Radar: an end-to-end Snowflake and dbt project on 484,242 public contract records, with the data problems and limits written up.",
  "Procurement context from DoD / DLA fuel-bid analysis and federal contracting data. Useful background, not the only domain I work in.",
];

const roles = [
  "Data Analyst / Senior Data Analyst",
  "BI / Reporting Analyst",
  "Data Quality / Governance Analyst",
  "Operations / Program Analyst",
  "Analytics Engineer",
];

const bestProof = [
  {
    n: "01",
    t: "Recompete Radar",
    d: "End-to-end Snowflake and dbt project",
    u: "/recompete-radar",
  },
  {
    n: "02",
    t: "NAHB membership data & reporting",
    d: "114K+ member records, 500+ local associations",
    u: null,
  },
  {
    n: "03",
    t: "Four traps in public contract data",
    d: "Data quality, found and written up",
    u: "/projects/sunlight-recompete-radar#brief",
  },
  {
    n: "04",
    t: "Mortgage Risk Observatory",
    d: "Tested dbt marts and quality gates",
    u: "https://github.com/PHiZou/loan-performance-pipeline",
  },
  {
    n: "05",
    t: "Obsidian RAG Chat",
    d: "Answers that cite their sources",
    u: "/projects/obsidian-rag-chat",
  },
];

const background = [
  {
    org: "National Association of Home Builders",
    role: "Senior Data Analyst (Jul 2024 to Jul 2025) · Director, Membership Data (Feb 2023 to Jul 2024)",
    detail:
      "Reporting layers, dashboards, recurring analytics workflows and segmentation for leadership, on 114K+ member records across 500+ local associations.",
  },
  {
    org: "Defense Government Contracting International (DGCI)",
    role: "Business Analyst",
    detail: "DoD / DLA fuel-bid analysis.",
  },
  {
    org: "George Mason University",
    role: "M.S. Systems Engineering",
    detail: "Systems methodology, decision analysis, modeling.",
  },
  {
    org: "Virginia Tech",
    role: "B.S. Industrial & Systems Engineering",
    detail: "Operations research, statistics, process optimization.",
  },
];
---

<BaseLayout
  title="Resume – Peter Hagen"
  description="Peter Hagen's resume. A systems-minded analyst and builder who takes messy real-world data, tests it, and turns it into explainable reporting and tools."
>
  <section style="border-bottom: 1px solid var(--border); padding: 64px 24px 48px;">
    <div class="wrap-narrow">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
        <div class="pulse-dot"></div>
        <span class="kicker">Open to full-time roles · available now · NOVA/DMV</span>
      </div>
      <h1 style="font-size: clamp(1.75rem, 4vw, 2.2rem); font-weight: 700; color: var(--ink); margin-bottom: 12px;">
        Peter Hagen
      </h1>
      <p style="font-size: 0.9375rem; color: var(--ink-3); margin-bottom: 24px; line-height: 1.6;">
        A systems-minded analyst and builder. I take messy real-world data, test it, find where
        it breaks, and turn it into reporting and tools people can explain.
      </p>
      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <a href="/pdf/Peter-Hagen-Resume.pdf" download class="btn-primary">Download resume (PDF)</a>
        <a href="mailto:Peter.H.Hagen@gmail.com" class="btn-outline">Contact Peter</a>
        <a href="https://www.linkedin.com/in/peterhagen123" target="_blank" rel="noopener noreferrer" class="btn-outline">LinkedIn ↗</a>
        <a href="https://github.com/PHiZou" target="_blank" rel="noopener noreferrer" class="btn-outline">GitHub ↗</a>
      </div>
    </div>
  </section>

  <section style="padding: 40px 24px;">
    <div class="wrap-narrow" style="display: flex; flex-direction: column; gap: 28px;">
      <div>
        <div class="resume-label">Why interview Peter</div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {whyInterview.map((b) => (
            <div style="display: flex; gap: 10px; align-items: flex-start;">
              <span style="color: var(--teal-text); flex-shrink: 0; margin-top: 1px;">▸</span>
              <span style="font-size: 0.8125rem; line-height: 1.65; color: var(--ink-3);">{b}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="divider"></div>

      <div>
        <div class="resume-label">Roles I fit</div>
        <div class="card" style="padding: 20px;">
          <div style="display: flex; flex-direction: column; gap: 6px;">
            {roles.map((r) => (
              <div style="display: flex; gap: 8px; align-items: center;">
                <span class="role-dot" style="background: var(--teal-text);"></span>
                <span style="font-size: 0.8125rem; color: var(--ink-2);">{r}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="divider"></div>

      <div>
        <div class="resume-label">Best proof to review first</div>
        <div style="display: flex; flex-direction: column;">
          {bestProof.map((p) => (
            <div class="proof-row">
              <span class="mono" style="font-size: 0.7rem; color: var(--border-strong); font-weight: 500;">{p.n}</span>
              {p.u ? (
                <a
                  href={p.u}
                  target={p.u.startsWith("http") ? "_blank" : undefined}
                  rel={p.u.startsWith("http") ? "noopener noreferrer" : undefined}
                  class="proof-title"
                >
                  {p.t} →
                </a>
              ) : (
                <span class="proof-title" style="cursor: default;">{p.t}</span>
              )}
              <span style="font-size: 0.72rem; color: var(--ink-5); margin-left: auto;">{p.d}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="divider"></div>

      <div>
        <div class="resume-label">Background</div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          {background.map((item) => (
            <div style="padding-bottom: 12px; border-bottom: 1px solid var(--border);">
              <div style="font-size: 0.8125rem; font-weight: 600; color: var(--ink);">{item.org}</div>
              <div style="font-size: 0.72rem; color: var(--teal-text); margin-bottom: 4px;">{item.role}</div>
              <div style="font-size: 0.72rem; color: var(--ink-4); line-height: 1.6;">{item.detail}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="divider"></div>

      <div>
        <div class="resume-label">Full resume</div>
        <div class="pdf-frame">
          <iframe title="Peter Hagen Resume PDF" src="/pdf/Peter-Hagen-Resume.pdf" loading="lazy"></iframe>
        </div>
        <p class="sr-only">If the PDF does not display, please use the download button above.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-5);
    margin-bottom: 14px;
  }
  .role-dot { width: 4px; height: 4px; border-radius: 50%; flex-shrink: 0; }
  .proof-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .proof-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  a.proof-title:hover { color: var(--teal-text); }
  .pdf-frame {
    aspect-ratio: 8.5 / 11;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .pdf-frame iframe { width: 100%; height: 100%; border: 0; }
  @media (max-width: 760px) {
    section { padding-left: 18px; padding-right: 18px; }
    .proof-row { flex-wrap: wrap; }
  }
</style>
