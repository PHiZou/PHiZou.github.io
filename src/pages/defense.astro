---
import BaseLayout from "../layouts/BaseLayout.astro";
import HireBridge from "../components/HireBridge.astro";

const items = [
  {
    title: "FY27 Defense Strategic Acquisition Analysis",
    type: "Structured analytical writing · GovCon",
    method:
      "Public budget documents, acquisition policy sources, and market research synthesized into a strategic analysis deck.",
    analytical:
      "Budget-cycle reasoning, acquisition-pathway analysis (IDIQ, OTA, GWAC), competitive positioning.",
    technical: "Research synthesis and executive-ready presentation of a complex procurement landscape.",
    takeaway:
      "Can produce the market-facing analysis a capture or pricing team needs — not just the data plumbing behind it.",
    url: "https://fy27-defense-acquisition.vercel.app",
    caseStudy: "/projects/fy27-defense-acquisition",
  },
  {
    title: "Iran Conflict Operational Intelligence Dashboard",
    type: "Multi-view dashboarding · OSINT data",
    method:
      "Open-source event data structured into an escalation index, force-posture views, chokepoint analysis, and scenario pathways.",
    analytical: "Composite scoring design, weighted event categorization, scenario/branching analysis.",
    technical: "React multi-view dashboard architecture, coordinated views, KPI design.",
    takeaway:
      "Can design and build the structured analytical product — metric definitions through UI — that analytics teams ship.",
    url: "https://iran-conflict-portfolio.vercel.app",
    caseStudy: "/projects/iran-conflict-dashboard",
  },
  {
    title: "Iran–US Conflict Map",
    type: "Geospatial visualization · OSINT data",
    method:
      "Open-source conflict event data mapped day-by-day: strikes, naval engagements, oil disruption, humanitarian impact.",
    analytical: "Event data modeling, temporal-geographic storytelling, careful sourcing of public data.",
    technical: "D3 interactive mapping, timeline UI, geographic overlays.",
    takeaway: "Can turn a complex, fast-moving dataset into something a non-analyst can navigate and trust.",
    url: "https://iran-us-conflict-map2.vercel.app/",
    caseStudy: "/projects/iran-us-conflict-map",
  },
];
---

<BaseLayout
  title="Defense & Intel Analytics – Peter Hagen"
  description="Open-source defense and GovCon analytics demos: acquisition analysis, OSINT dashboards, and geospatial conflict visualization built on public data."
>
  <section class="defense-hero">
    <div class="wrap">
      <div style="display: flex; gap: 8px; margin-bottom: 16px;">
        <span class="badge badge-defense">Open-source analytics demos</span>
      </div>
      <h1 class="page-title" style="margin-bottom: 12px;">
        Open-source defense &<br />
        <span style="color: var(--red-text);">GovCon analytics demos.</span>
      </h1>
      <p style="font-size: 0.875rem; line-height: 1.7; color: var(--ink-3); max-width: 620px; margin-bottom: 12px;">
        These projects use public and open-source data. They are portfolio demonstrations of data
        modeling, dashboarding, geospatial visualization, and structured analytical writing —
        relevant to GovCon data analyst, capture/pricing analyst, procurement intelligence, and BI
        roles at contractors and GovCon tech companies.
      </p>
    </div>
  </section>

  <section style="padding: 48px 24px;">
    <div class="wrap" style="display: flex; flex-direction: column; gap: 20px;">
      {items.map((item) => (
        <div class="card defense-card">
          <div style="display: flex; flex-direction: column; gap: 10px;">
            <div class="mono defense-type">{item.type}</div>
            <h2 style="font-size: 1rem; font-weight: 700; color: var(--ink);">
              <a href={item.caseStudy} style="color: inherit; text-decoration: none;">{item.title}</a>
            </h2>
            <div class="defense-line"><strong style="color: var(--ink-2);">Source & method:</strong> {item.method}</div>
            <div class="defense-line"><strong style="color: var(--ink-2);">Analytical skill:</strong> {item.analytical}</div>
            <div class="defense-line"><strong style="color: var(--ink-2);">Technical skill:</strong> {item.technical}</div>
            <div class="defense-takeaway">
              <strong>Hiring-manager takeaway:</strong>
              <span style="color: var(--ink-3);"> {item.takeaway}</span>
            </div>
          </div>
          <div style="display: flex; flex-direction: column; gap: 8px; align-items: stretch;">
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="btn-primary" style="font-size: 0.75rem; white-space: nowrap; justify-content: center;">Launch ↗</a>
            <a href={item.caseStudy} class="btn-outline" style="font-size: 0.75rem; white-space: nowrap; justify-content: center;">Case study</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <HireBridge note="No claims of classified or operational intelligence work — these are public-data demonstrations of analytics craft for defense-adjacent teams." />
</BaseLayout>

<style>
  .defense-hero {
    border-bottom: 1px solid var(--border);
    padding: 64px 24px 48px;
    background: oklch(0.94 0.02 25 / 0.35);
  }
  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .defense-card {
    padding: 28px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: start;
  }
  .defense-type {
    font-size: 0.62rem;
    font-weight: 700;
    color: oklch(0.55 0.07 25);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .defense-line { font-size: 0.75rem; line-height: 1.65; color: var(--ink-3); }
  .defense-takeaway {
    font-size: 0.75rem;
    line-height: 1.65;
    color: var(--teal-text);
    border-top: 1px solid var(--border);
    padding-top: 10px;
  }
  @media (max-width: 760px) {
    .defense-card { grid-template-columns: 1fr; }
    .defense-hero, section { padding-left: 18px; padding-right: 18px; }
  }
</style>
